<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#F59E0B</item>
        <item name="colorPrimaryDark">#0F172A</item>
        <item name="colorAccent">#10B981</item>
    </style>

    <!-- Launch screen: no title bar, dark background matching the app's slate-950 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">#0F172A</item>
        <item name="windowSplashScreenBackground">#0F172A</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
