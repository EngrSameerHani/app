<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#F59E0B</item>
        <item name="colorPrimaryDark">#0F172A</item>
        <item name="colorAccent">#10B981</item>
    </style>

    <!--
        Launch theme using the AndroidX SplashScreen API.
        Theme.SplashScreen is provided by androidx.core:core-splashscreen.
        postSplashScreenTheme switches to AppTheme after the splash.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F172A</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
